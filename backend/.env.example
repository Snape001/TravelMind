# 本地 Compose 发布到宿主机的连接地址
# Replace POSTGRES_PASSWORD with the URL-encoded password configured for Compose.
DATABASE_URL=postgresql+asyncpg://travelmind:POSTGRES_PASSWORD@127.0.0.1:15432/travelmind
REDIS_URL=redis://127.0.0.1:16379/0

# 在本地 .env 填入 DeepSeek API Key
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEPENDENCY_TIMEOUT_SECONDS=3

# Research Engine 密钥。OpenAlex 支持匿名查询。
BOCHA_API_KEY=
FIRECRAWL_API_KEY=
OPENALEX_API_KEY=
RESEARCH_TIMEOUT_SECONDS=35

# 古籍文献知识图谱网，供非商业学习与研究使用。启用后无需 API Key。
CNKGRAPH_ENABLED=false

# 个人非商业研究。仅本机 Worker 可访问本地已授权导出的证据缓存。
SOCIAL_RESEARCH_PROVIDER=disabled
SOCIAL_RESEARCH_URL=http://127.0.0.1:18764
SOCIAL_RESEARCH_TOKEN=
SOCIAL_RESEARCH_CACHE_PATH=
SOCIAL_RESEARCH_PLATFORMS=["zhihu","xiaohongshu","bilibili"]
SOCIAL_RESEARCH_TIMEOUT_SECONDS=3

# Amap Web Service
AMAP_WEB_API_KEY=

# Amap Web JS API
NEXT_PUBLIC_AMAP_JS_API_KEY=
AMAP_SECURITY_JS_CODE=
