# Production Keycloak settings. Pass these variables to Keycloak at import time.
TM_REALM_NAME=travelmind
TM_OIDC_CLIENT_ID=travelmind-web
TM_OIDC_CLIENT_SECRET=
TM_PUBLIC_ORIGIN=https://travelmind.example
KC_HOSTNAME=https://id.travelmind.example
KC_PROXY_HEADERS=xforwarded

# SMTP over STARTTLS on port 587. For implicit TLS use port 465, SSL=true and STARTTLS=false.
TM_SMTP_HOST=smtp.example
TM_SMTP_PORT=587
TM_SMTP_FROM=no-reply@travelmind.example
TM_SMTP_USER=
TM_SMTP_PASSWORD=
TM_SMTP_SSL=false
TM_SMTP_STARTTLS=true
