{
	admin off
	auto_https disable_redirects
}

https://travelmind.localhost:18443 {
	tls /local-pki/site.pem /local-pki/site-key.pem

	@api path /api/v1/* /health/*
	handle @api {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy frontend:3000
	}
}

https://id.travelmind.localhost:18443 {
	tls /local-pki/site.pem /local-pki/site-key.pem

	@identity path /realms/travelmind-dev/* /resources/*
	handle @identity {
		reverse_proxy keycloak:8080 {
			header_up X-Forwarded-Port 18443
		}
	}

	handle {
		respond 404
	}
}
